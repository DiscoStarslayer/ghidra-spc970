# SCP 970 Sleigh Specification file

define endian=little;
define alignment=1;

define space ram type=ram_space size=3 default;
define space io type=ram_space size=1;

define space register type=register_space size=2;

define register offset=0x00 size=1 [ RB0 _ RB1 _ RB2 _ RB3 _ RB4 _ RB5 _ RB6 _ RB7 _ ];
define register offset=0x00 size=2 [ RW0   RW1   RW2   RW3   RW4   RW5   _     _     ];
define register offset=0x00 size=2 [ _     _     _     _     _     _     FP    SP    ];
define register offset=0x00 size=4 [ RL0         RL2         RL4         RL6         ];

# PSW  Processor Status Word
# PC   Program Counter
# SSP  System Stack Pointer
# CP   Code Page Register
# DP   Data Page Register
# EP   Extra Page Register 
# UTP  User Stack Page Register
# STP  System Stack Page Register

define register offset=0x10 size=2 [ PSW PC  SSP USP _  _  _  _   _   ];
define register offset=0x10 size=1 [ _ _ _ _ _ _ _ _ CP DP EP UTP STP ];

# Ghidra bit range selector index 0 is LSB
@define IM		"PSW[13,3]"		# Interrupt Mask Register
@define BCR		"PSW[8,5]"		# Bank Control Register
@define S		"PSW[7,1]"		# Supervisor flag
@define I		"PSW[6,1]"		# Interrupt Enable Flag
@define M		"PSW[3,1]"		# MSB (negative) Flag
@define V		"PSW[2,1]"		# Overflow Flag
@define X		"PSW[1,1]"		# Extension Flag
@define Z		"PSW[0,1]"		# Zero Flag

# Fake flag registers, synced to actual PSW before PSW based ops
define register offset=0x22 size=1 [ IM BCR S I M V X Z T ];

# SPC970 has individual "banks" for registers, aka a register window
# BCR register selects currently active bank index. 
# SPC970 is assumed to have 16 banks, SPC970s 32 banks

# Following "Window" registers emulate this functionality within ghidra. 
# Actual registers are simply a pointer to this storage space
define register offset=0x30 size=2 [
	W000 W001 W002 W003 W004 W005 W006 W007
	W010 W011 W012 W013 W014 W015 W016 W017
	W020 W021 W022 W023 W024 W025 W026 W027
	W030 W031 W032 W033 W034 W035 W036 W037
	W040 W041 W042 W043 W044 W045 W046 W047
	W050 W051 W052 W053 W054 W055 W056 W057
	W060 W061 W062 W063 W064 W065 W066 W067
	W070 W071 W072 W073 W074 W075 W076 W077
	W080 W081 W082 W083 W084 W085 W086 W087
	W090 W091 W092 W093 W094 W095 W096 W097
	W100 W101 W102 W103 W104 W105 W106 W107
	W110 W111 W112 W113 W114 W115 W116 W117
	W120 W121 W122 W123 W124 W125 W126 W127
	W130 W131 W132 W133 W134 W135 W136 W137
	W140 W141 W142 W143 W144 W145 W146 W147
	W150 W151 W152 W153 W154 W155 W156 W157
];

define register offset=0x1000 size=32 contextreg;
define context contextreg
	phase		= (0,3)
	tbl8Mode	= (4,6)
	tbl2Width	= (7,7)
	prefix		= (8,15)
	data1		= (16,39)
	sdata1		= (16,39) signed
	data2		= (40,55)
	sdata2		= (40,55) signed
	data3		= (56,79)
	sdata3		= (56,79) signed
	prefix2		= (80,95)
	data4		= (96,111)
	sdata4		= (96,111) signed
;

define token opbyte (8)
	op0_8		= (0,7)
	op0_4		= (4,7)
	
	opHalf4_1	= (3,3)
	opMode4_4	= (0,3)
	simm4_4		= (0,3) signed
	imm4_4		= (0,3)
	
	opData5_3	= (0,2)
	bReg5_3		= (0,2)
	wReg5_3		= (0,2)
	lReg5_3		= (0,2)
	cReg5_3		= (0,2)
	cwReg5_3	= (0,2)
;

define token bdata (8)
	imm8		= (0,7)
	simm8		= (0,7) signed

# LDM
# 0 1 2 3 4 5 6 7
	ldmRW0		= (0,0)
	ldmRW1		= (1,1)
	ldmRW2		= (2,2)
	ldmRW3		= (3,3)
	ldmRW4		= (4,4)
	ldmRW5		= (5,5)
	ldmRW6		= (6,6)
	ldmRW7		= (7,7)
	ldmRW1N		= (1,7)
	ldmRW2N		= (2,7)
	ldmRW3N		= (3,7)
	ldmRW4N		= (4,7)
	ldmRW5N		= (5,7)
	ldmRW6N		= (6,7)
	ldmRW7N		= (7,7)
# STM
# 7 6 5 4 3 2 1 0	
	stmRW7		= (0,0)
	stmRW6		= (1,1)
	stmRW5		= (2,2)
	stmRW4		= (3,3)
	stmRW3		= (4,4)
	stmRW2		= (5,5)
	stmRW1		= (6,6)
	stmRW0		= (7,7)	
	stmRW7N		= (0,0)
	stmRW6N		= (0,1)
	stmRW5N		= (0,2)
	stmRW4N		= (0,3)
	stmRW3N		= (0,4)
	stmRW2N		= (0,5)
	stmRW1N		= (0,6)
;

define token wdata (16)
	imm16		= (0, 15)
	simm16		= (0, 15) signed
;

define token adata (24)
	imm24		= (0,23)
;

attach variables [ bReg5_3  ] [ RB0 RB1 RB2 RB3 RB4 RB5 RB6 RB7 ];
attach variables [ wReg5_3  ] [ RW0 RW1 RW2 RW3 RW4 RW5 FP  SP  ];
attach variables [ lReg5_3  ] [ RL0 _   RL2 _   RL4 _   RL6 _   ];
attach variables [ cReg5_3  ] [ UTP DP  EP  STP _   _   IM  BCR ];
attach variables [ cwReg5_3 ] [ _   _   _   _   _   PSW _   _   ];

# Custom pcode ops to reference segments using CP, EP and DP page registers
define pcodeop segment;

define pcodeop trap;
define pcodeop trapException;

define pcodeop enableInterrupts;
define pcodeop disableInterrupts;

define pcodeop loadCtx;
define pcodeop sleep;
define pcodeop stop;

# Macro for changing register bank
@define NUMREGBANKS 16
@define REGBANKSZ 8

macro regbank(from,to) {
	# Store current registers to window
	*[register]:2 ((&W000) + (from:4 * $(REGBANKSZ) + 0) * 2) = RW0; 
	*[register]:2 ((&W000) + (from:4 * $(REGBANKSZ) + 1) * 2) = RW1; 
	*[register]:2 ((&W000) + (from:4 * $(REGBANKSZ) + 2) * 2) = RW2; 
	*[register]:2 ((&W000) + (from:4 * $(REGBANKSZ) + 3) * 2) = RW3; 
	*[register]:2 ((&W000) + (from:4 * $(REGBANKSZ) + 4) * 2) = RW4; 
	*[register]:2 ((&W000) + (from:4 * $(REGBANKSZ) + 5) * 2) = RW5; 
	*[register]:2 ((&W000) + (from:4 * $(REGBANKSZ) + 6) * 2) = FP; 
	*[register]:2 ((&W000) + (from:4 * $(REGBANKSZ) + 7) * 2) = SP; 
	
	# Load new window into registers
	RW0 = *[register]:2 ((&W000) + (to:4 * $(REGBANKSZ) + 0) * 2);
	RW1 = *[register]:2 ((&W000) + (to:4 * $(REGBANKSZ) + 1) * 2);
	RW2 = *[register]:2 ((&W000) + (to:4 * $(REGBANKSZ) + 2) * 2);
	RW3 = *[register]:2 ((&W000) + (to:4 * $(REGBANKSZ) + 3) * 2);
	RW4 = *[register]:2 ((&W000) + (to:4 * $(REGBANKSZ) + 4) * 2);
	RW5 = *[register]:2 ((&W000) + (to:4 * $(REGBANKSZ) + 5) * 2);
	FP  = *[register]:2 ((&W000) + (to:4 * $(REGBANKSZ) + 6) * 2);
	SP  = *[register]:2 ((&W000) + (to:4 * $(REGBANKSZ) + 7) * 2);
}

macro addFlags(op1,op2) {
	X = carry(op1,op2);
	V = scarry(op1,op2);
}

macro subFlags(op1,op2) {
	X = op1 < op2;
	V = sborrow(op1,op2);
}

macro zeroFlags(result) {
	Z = result == 0;
	M = result s< 0;
}

macro push16(val16) {
	SP = SP - 2;
	ptr:3 = segment(UTP,SP);
	*:2 ptr = val16;
}

macro pop16(val16) {
	ptr:3 = segment(UTP,SP);
	val16 = *:2 ptr;
	SP = SP + 2;
}

macro push8(val8) {
	SP = SP - 2;
	ptr:3 = segment(UTP,SP);
	*:2 ptr = zext(val8);
}

macro pop8(val8) {
	ptr:3 = segment(UTP,SP);
	res:2 = *:2 ptr;
	val8 = res:1;
	SP = SP + 2;
}

macro syncFlags() {
	PSW = 0;
	PSW = PSW & (zext(IM & 0x7) << 13);
	PSW = PSW & (zext(BCR & 0x1F) << 8);
	PSW = PSW & (zext(S & 0x1) << 7);
	PSW = PSW & (zext(I & 0x1) << 6);
	PSW = PSW & (zext(M & 0x1) << 3);
	PSW = PSW & (zext(V & 0x1) << 2);
	PSW = PSW & (zext(X & 0x1) << 1);
	PSW = PSW & zext(Z & 0x1);
}

macro syncPSW() {
	IM = (PSW >> 13) & 0x7;
	BCR = (PSW >> 8) & 0x1F;
	S = (PSW >> 7) & 0x1;
	I = (PSW >> 6) & 0x1;
	M = (PSW >> 3) & 0x1;
	V = (PSW >> 2) & 0x1;
	X = (PSW >> 1) & 0x1;
	Z = PSW & 0x1;
}

immVal8: #imm8 is imm8 { local tmp:1 = imm8; export tmp; }
immVal16: #imm16 is imm16 { local tmp:2 = imm16; export tmp; }

# Code Pointer (CP) is used as high value of PC, use this to our advantage
cpAddr16: loc is imm16 [ loc = (inst_next & 0xFF0000) + imm16; ] { export *:1 loc; }

immAddr8: loc is imm8 [ loc = 0 + imm8; ] { export *[io]:1 loc; }
immAddr24: imm24 is imm24 { export *:1 imm24; }

relAddr8: loc is simm8 [ loc = inst_next + simm8; ] { export *:1 loc; }

tjsrAddr3: loc is opData5_3 [ loc = inst_next + opData5_3; ] { export *:1 loc; }

bIdx3: opData5_3 is opData5_3 {
	local tmp:1 = opData5_3;
	export tmp; 
}

bAddrAbs11: val is opData5_3; imm8 [ val = (opData5_3 << 8) + imm8; ] { tmp:3 = zext(val:2); export *:1 tmp; }
wAddrAbs11: val is opData5_3; imm8 [ val = (opData5_3 << 8) + imm8; ] { tmp:3 = zext(val:2); export *:2 tmp; }
bAddrAbs16: val is imm16 [ val = (DP << 16) + imm16; ] { export *:1 val; }
wAddrAbs16: val is imm16 [ val = (DP << 16) + imm16; ] { export *:2 val; }
bAddrAbs24: immAddr24 is immAddr24 { export *:1 immAddr24; }
wAddrAbs24: immAddr24 is immAddr24 { export *:2 immAddr24; }

regIndirect: wReg5_3 is (opData5_3=0 | opData5_3=1 | opData5_3=2 | opData5_3=3) & wReg5_3 { tmp:3 = segment(DP,wReg5_3); export *:1 tmp; }
regIndirect: wReg5_3 is (opData5_3=4 | opData5_3=5) & wReg5_3 { tmp:3 = segment(EP,wReg5_3); export *:1 tmp; }
regIndirect: wReg5_3 is (opData5_3=6 | opData5_3=7) & wReg5_3 { tmp:3 = segment(UTP,wReg5_3); export *:1 tmp; }

####### OP Preludes
# Preludes are described as instruction prefixes in context register
# otherwise the combination of prefixes are OR'ed instead of AND'ed

# Table 2 preludes
:^instruction is phase=0 & op0_4=0x2 & simm4_4										; instruction [ prefix=0x2 ; phase=1; data1=simm4_4; tbl2Width=0; ] {}
:^instruction is phase=0 & op0_4=0x3 & simm4_4										; instruction [ prefix=0x3 ; phase=1; data1=simm4_4; tbl2Width=1; ] {}
:^instruction is phase=0 & op0_4=0x8 & opHalf4_1=0x0 & opData5_3 ; imm8				; instruction [ prefix=0x80; phase=1; data1=opData5_3; data2=imm8; tbl2Width=0; ] {}
:^instruction is phase=0 & op0_4=0x8 & opHalf4_1=0x1 & opData5_3 ; imm8				; instruction [ prefix=0x81; phase=1; data1=opData5_3; data2=imm8; tbl2Width=1; ] {}
:^instruction is phase=0 & op0_4=0x9 & opHalf4_1=0x0 & opData5_3 & wReg5_3 ; simm16	; instruction [ prefix=0x90; phase=1; data1=opData5_3; data2=simm16; tbl2Width=0; ] {}
:^instruction is phase=0 & op0_4=0x9 & opHalf4_1=0x1 & opData5_3 & wReg5_3 ; simm16	; instruction [ prefix=0x91; phase=1; data1=opData5_3; data2=simm16; tbl2Width=1; ] {}
:^instruction is phase=0 & op0_4=0xA & opHalf4_1=0x0 & opData5_3 & wReg5_3 ; simm8	; instruction [ prefix=0xA0; phase=1; data1=opData5_3; data2=simm8; tbl2Width=0; ] {}
:^instruction is phase=0 & op0_4=0xA & opHalf4_1=0x1 & opData5_3 & wReg5_3 ; simm8	; instruction [ prefix=0xA1; phase=1; data1=opData5_3; data2=simm8; tbl2Width=1; ] {}
:^instruction is phase=0 & op0_4=0xB & opHalf4_1=0x0 & opData5_3 					; instruction [ prefix=0xB0; phase=1; data1=opData5_3; tbl2Width=0; ] {}
:^instruction is phase=0 & op0_4=0xB & opHalf4_1=0x1 & opData5_3 					; instruction [ prefix=0xB1; phase=1; data1=opData5_3; tbl2Width=1; ] {}
:^instruction is phase=0 & op0_4=0xC & opHalf4_1=0x0 & opData5_3 					; instruction [ prefix=0xC0; phase=1; data1=opData5_3; tbl2Width=0; ] {}
:^instruction is phase=0 & op0_4=0xC & opHalf4_1=0x1 & opData5_3 					; instruction [ prefix=0xC1; phase=1; data1=opData5_3; tbl2Width=1; ] {}
:^instruction is phase=0 & op0_8=0xE0									   ; simm16	; instruction [ prefix=0xE0; phase=1; data1=simm16; tbl2Width=0; ] {}
:^instruction is phase=0 & op0_8=0xE1                                      ; imm24	; instruction [ prefix=0xE1; phase=1; data1=imm24; tbl2Width=0; ] {}
:^instruction is phase=0 & op0_8=0xE7                								; instruction [ prefix=0xE7; phase=1; tbl2Width=0; ] {}
:^instruction is phase=0 & op0_8=0xE8                					   ; simm16	; instruction [ prefix=0xE8; phase=1; data1=simm16; tbl2Width=1; ] {}
:^instruction is phase=0 & op0_8=0xE9                					   ; imm24	; instruction [ prefix=0xE9; phase=1; data1=imm24; tbl2Width=1; ] {}
:^instruction is phase=0 & op0_8=0xEF                								; instruction [ prefix=0xEF; phase=1; tbl2Width=1; ] {}

# Table 3 preludes
:^instruction is phase=0 & op0_4=0xD & opHalf4_1=0x0 & opData5_3					; instruction [ prefix=0xD0; phase=2; data1=opData5_3; ] {}
:^instruction is phase=0 & op0_4=0xD & opHalf4_1=0x1 & opData5_3					; instruction [ prefix=0xD1; phase=2; data1=opData5_3; ] {}
:^instruction is phase=0 & op0_8=0xE2 									   ; imm8	; instruction [ prefix=0xE2; phase=2; data1=imm8; ] {}
:^instruction is phase=0 & op0_8=0xEA 									   ; imm16	; instruction [ prefix=0xEA; phase=2; data1=imm16; ] {}
:^instruction is phase=0 & op0_8=0xFE 									   ; imm8	; instruction [ prefix=0xFE; phase=2; data1=imm8; ] {}

# Table 4 preludes
:^instruction is phase=0 & op0_4=0x1 & opHalf4_1=0 & opData5_3						; instruction [ prefix=0x10; phase=3; data1=opData5_3; ] {}

# Table 5 preludes
:^instruction is phase=0 & op0_8=0xF3												; instruction [ prefix=0xF3; phase=4; ] {}
# TODO: Hack, using undefined prefixes to signal entry point is tbl5 when pointing to tbl2
:^instruction is phase=4 & op0_4=0x9 & opHalf4_1=0 & opData5_3						; instruction [ prefix=0xF0; phase=1; data1=opData5_3; ] {}
:^instruction is phase=4 & op0_4=0x9 & opHalf4_1=1 & opData5_3						; instruction [ prefix=0xF1; phase=1; data1=opData5_3; ] {}
:^instruction is phase=4 & op0_4=0xA & opHalf4_1=0 & opData5_3						; instruction [ prefix=0xF2; phase=1; data1=opData5_3; ] {}
:^instruction is phase=4 & op0_4=0xA & opHalf4_1=1 & opData5_3						; instruction [ prefix=0xF3; phase=1; data1=opData5_3; ] {}

# Table 7 preludes
# Table 7 only reachable through table 2
:^instruction is phase=1 & op0_8=0xE2												; instruction [ phase=6; ] {}

# Table 6 preludes
# From tbl2:
:^instruction is phase=1 & op0_4=0x8 & opHalf4_1=0 & opData5_3				; imm8	; instruction [ prefix2=0x0280; phase=5; data3=opData5_3; data4=imm8; ] {}
:^instruction is phase=1 & op0_4=0x9 & opHalf4_1=0 & opData5_3				; simm16; instruction [ prefix2=0x0290; phase=5; data3=opData5_3; data4=simm16; ] {}
:^instruction is phase=1 & op0_4=0xA & opHalf4_1=0 & opData5_3				; simm8	; instruction [ prefix2=0x02A0; phase=5; data3=opData5_3; data4=simm8; ] {}
:^instruction is phase=1 & op0_4=0xB & opHalf4_1=0 & opData5_3						; instruction [ prefix2=0x02B0; phase=5; data3=opData5_3; ] {}
:^instruction is phase=1 & op0_4=0xC & opHalf4_1=0 & opData5_3						; instruction [ prefix2=0x02C0; phase=5; data3=opData5_3; ] {}
:^instruction is phase=1 & op0_8=0xE0										; imm16	; instruction [ prefix2=0x02E0; phase=5; data3=imm16; ] {}
:^instruction is phase=1 & op0_8=0xE1										; imm24	; instruction [ prefix2=0x02E1; phase=5; data3=imm24; ] {}
# From tbl3:
:^instruction is phase=2 & op0_4=0x8 & opHalf4_1=0 & opData5_3				; imm8	; instruction [ prefix2=0x0380; phase=5; data3=opData5_3; data4=imm8; ] {}
:^instruction is phase=2 & op0_4=0x9 & opHalf4_1=0 & opData5_3				; simm16; instruction [ prefix2=0x0390; phase=5; data3=opData5_3; data4=simm16; ] {}
:^instruction is phase=2 & op0_4=0xA & opHalf4_1=0 & opData5_3				; simm8	; instruction [ prefix2=0x03A0; phase=5; data3=opData5_3; data4=simm8; ] {}
:^instruction is phase=2 & op0_4=0xB & opHalf4_1=0 & opData5_3						; instruction [ prefix2=0x03B0; phase=5; data3=opData5_3; ] {}
:^instruction is phase=2 & op0_4=0xC & opHalf4_1=0 & opData5_3						; instruction [ prefix2=0x03C0; phase=5; data3=opData5_3; ] {}
:^instruction is phase=2 & op0_8=0xE0										; imm16	; instruction [ prefix2=0x03E0; phase=5; data3=imm16; ] {}
:^instruction is phase=2 & op0_8=0xE1										; imm24	; instruction [ prefix2=0x03E1; phase=5; data3=imm24; ] {}
# From tbl7:
:^instruction is phase=6 & op0_4=0x9 & opHalf4_1=0 & opData5_3						; instruction [ prefix2=0x0790; phase=5; data3=opData5_3; ] {}
:^instruction is phase=6 & op0_4=0xA & opHalf4_1=0 & opData5_3						; instruction [ prefix2=0x07A0; phase=5; data3=opData5_3; ] {}
:^instruction is phase=6 & op0_4=0xA & opHalf4_1=1 & opData5_3						; instruction [ prefix2=0x07A1; phase=5; data3=opData5_3; ] {}
# From tbl8:
:^instruction is phase=7 & op0_4=0x9 & opHalf4_1=0 & opData5_3						; instruction [ prefix2=0x0890; phase=5; data3=opData5_3; ] {}
:^instruction is phase=7 & op0_4=0xA & opHalf4_1=0 & opData5_3						; instruction [ prefix2=0x08A0; phase=5; data3=opData5_3; ] {}
:^instruction is phase=7 & op0_4=0xA & opHalf4_1=1 & opData5_3						; instruction [ prefix2=0x08A1; phase=5; data3=opData5_3; ] {}

# Table 8 preludes
# Table 8 only reachable through table 3
:^instruction is phase=2 & op0_8=0xE2												; instruction [ phase=7; tbl8Mode=0; ] {}
:^instruction is phase=2 & op0_8=0xE7										; imm16	; instruction [ phase=7; tbl8Mode=1; data2=imm16; ] {}

bConToReg: RB0 is data1=0 & RB0 { export RB0; }
bConToReg: RB1 is data1=1 & RB1 { export RB1; }
bConToReg: RB2 is data1=2 & RB2 { export RB2; }
bConToReg: RB3 is data1=3 & RB3 { export RB3; }
bConToReg: RB4 is data1=4 & RB4 { export RB4; }
bConToReg: RB5 is data1=5 & RB5 { export RB5; }
bConToReg: RB6 is data1=6 & RB6 { export RB6; }
bConToReg: RB7 is data1=7 & RB7 { export RB7; }

wConToReg: RW0 is data1=0 & RW0 { export RW0; }
wConToReg: RW1 is data1=1 & RW1 { export RW1; }
wConToReg: RW2 is data1=2 & RW2 { export RW2; }
wConToReg: RW3 is data1=3 & RW3 { export RW3; }
wConToReg: RW4 is data1=4 & RW4 { export RW4; }
wConToReg: RW5 is data1=5 & RW5 { export RW5; }
wConToReg: FP  is data1=6 & FP  { export FP;  }
wConToReg: SP  is data1=7 & SP  { export SP;  }

lConToReg: RL0 is data1=0 & RL0 { export RL0; }
lConToReg: RL2 is data1=2 & RL2 { export RL2; }
lConToReg: RL4 is data1=4 & RL4 { export RL4; }
lConToReg: RL6 is data1=6 & RL6 { export RL6; }

bCon3ToReg: RB0 is data3=0 & RB0 { export RB0; }
bCon3ToReg: RB1 is data3=1 & RB1 { export RB1; }
bCon3ToReg: RB2 is data3=2 & RB2 { export RB2; }
bCon3ToReg: RB3 is data3=3 & RB3 { export RB3; }
bCon3ToReg: RB4 is data3=4 & RB4 { export RB4; }
bCon3ToReg: RB5 is data3=5 & RB5 { export RB5; }
bCon3ToReg: RB6 is data3=6 & RB6 { export RB6; }
bCon3ToReg: RB7 is data3=7 & RB7 { export RB7; }

wCon3ToReg: RW0 is data3=0 & RW0 { export RW0; }
wCon3ToReg: RW1 is data3=1 & RW1 { export RW1; }
wCon3ToReg: RW2 is data3=2 & RW2 { export RW2; }
wCon3ToReg: RW3 is data3=3 & RW3 { export RW3; }
wCon3ToReg: RW4 is data3=4 & RW4 { export RW4; }
wCon3ToReg: RW5 is data3=5 & RW5 { export RW5; }
wCon3ToReg: FP  is data3=6 & FP  { export FP;  }
wCon3ToReg: SP  is data3=7 & SP  { export SP;  }

lCon3ToReg: RL0 is data3=0 & RL0 { export RL0; }
lCon3ToReg: RL2 is data3=2 & RL2 { export RL2; }
lCon3ToReg: RL4 is data3=4 & RL4 { export RL4; }
lCon3ToReg: RL6 is data3=6 & RL6 { export RL6; }

cConToReg: UTP is data1=0 & UTP { export UTP; }
cConToReg: DP  is data1=1 & DP  { export DP ; }
cConToReg: EP  is data1=2 & EP  { export EP ; }
cConToReg: STP is data1=3 & STP { export STP; }
# TODO: These are unconfirmed
# cConToReg: SSP is data1=4 & SSP { export SSP; }
# cConToReg: USP is data1=5 & USP { export USP; }
cConToReg: IM  is data1=6 & IM  { export IM ; }
cConToReg: BCR is data1=7 & BCR { export BCR; }

extRegVal: wConToReg is (data1=0 | data1=1 | data1=2 | data1=3) & wConToReg { tmp:3 = segment(DP,wConToReg); export tmp; }
extRegVal: wConToReg is (data1=4 | data1=5) & wConToReg { tmp:3 = segment(EP,wConToReg); export tmp; }
extRegVal: wConToReg is (data1=6 | data1=7) & wConToReg { tmp:3 = segment(UTP,wConToReg); export tmp; }

indRegVal: wReg5_3 is (opData5_3=0 | opData5_3=1 | opData5_3=2 | opData5_3=3) & wReg5_3 { tmp:3 = segment(DP,wReg5_3); export tmp; }
indRegVal: wReg5_3 is (opData5_3=4 | opData5_3=5) & wReg5_3 { tmp:3 = segment(EP,wReg5_3); export tmp; }
indRegVal: wReg5_3 is (opData5_3=6 | opData5_3=7) & wReg5_3 { tmp:3 = segment(UTP,wReg5_3); export tmp; }

predExtRegVal: wConToReg is (data1=0 | data1=1 | data1=2 | data1=3) & wConToReg { wConToReg = wConToReg - 1; tmp:3 = segment(DP,wConToReg); export tmp; }
predExtRegVal: wConToReg is (data1=4 | data1=5) & wConToReg { wConToReg = wConToReg - 1; tmp:3 = segment(EP,wConToReg); export tmp; }
predExtRegVal: wConToReg is (data1=6 | data1=7) & wConToReg { wConToReg = wConToReg - 1; tmp:3 = segment(UTP,wConToReg); export tmp; }

pstiExtRegVal: wConToReg is (data1=0 | data1=1 | data1=2 | data1=3) & wConToReg { tmp:3 = segment(DP,wConToReg); wConToReg = wConToReg + 1; export tmp; }
pstiExtRegVal: wConToReg is (data1=4 | data1=5) & wConToReg { tmp:3 = segment(EP,wConToReg); wConToReg = wConToReg + 1; export tmp; }
pstiExtRegVal: wConToReg is (data1=6 | data1=7) & wConToReg { tmp:3 = segment(UTP,wConToReg); wConToReg = wConToReg + 1; export tmp; }

extRegVal3: wCon3ToReg is (data3=0 | data3=1 | data3=2 | data3=3) & wCon3ToReg { tmp:3 = segment(DP,wCon3ToReg); export tmp; }
extRegVal3: wCon3ToReg is (data3=4 | data3=5) & wCon3ToReg { tmp:3 = segment(EP,wCon3ToReg); export tmp; }
extRegVal3: wCon3ToReg is (data3=6 | data3=7) & wCon3ToReg { tmp:3 = segment(UTP,wCon3ToReg); export tmp; }

predExtRegVal3: wCon3ToReg is (data3=0 | data3=1 | data3=2 | data3=3) & wCon3ToReg { wCon3ToReg = wCon3ToReg - 1; tmp:3 = segment(DP,wCon3ToReg); export tmp; }
predExtRegVal3: wCon3ToReg is (data3=4 | data3=5) & wCon3ToReg { wCon3ToReg = wCon3ToReg - 1; tmp:3 = segment(EP,wCon3ToReg); export tmp; }
predExtRegVal3: wCon3ToReg is (data3=6 | data3=7) & wCon3ToReg { wCon3ToReg = wCon3ToReg - 1; tmp:3 = segment(UTP,wCon3ToReg); export tmp; }

pstiExtRegVal3: wCon3ToReg is (data3=0 | data3=1 | data3=2 | data3=3) & wCon3ToReg { tmp:3 = segment(DP,wCon3ToReg); wCon3ToReg = wCon3ToReg + 1; export tmp; }
pstiExtRegVal3: wCon3ToReg is (data3=4 | data3=5) & wCon3ToReg { tmp:3 = segment(EP,wCon3ToReg); wCon3ToReg = wCon3ToReg + 1; export tmp; }
pstiExtRegVal3: wCon3ToReg is (data3=6 | data3=7) & wCon3ToReg { tmp:3 = segment(UTP,wCon3ToReg); wCon3ToReg = wCon3ToReg + 1; export tmp; }

with :(phase=1|phase=5|phase=6) {

# bFpOffset
bArgTbl2: @(sdata1,FP) is prefix=0x2 & sdata1 & FP { ptr:3 = segment(UTP,FP); ptr = ptr + sext(sdata1:1); export *:1 ptr; }
wArgTbl2: @(sdata1,FP) is prefix=0x3 & sdata1 & FP { ptr:3 = segment(UTP,FP); ptr = ptr + sext(sdata1:1); export *:2 ptr; }

# bImmAddr11
bArgTbl2: val is prefix=0x80 & data1 & data2 [ val = (data1 << 8) + data2; ] { tmp:3 = zext(val:2); export *:1 tmp; }
wArgTbl2: val is prefix=0x81 & data1 & data2 [ val = (data1 << 8) + data2; ] { tmp:3 = zext(val:2); export *:2 tmp; }

# bRW2Offset
bArgTbl2: @(sdata2,extRegVal) is prefix=0x90 & extRegVal & sdata2 { ptr:3 = extRegVal + sext(sdata2:2); export *:1 ptr; }
wArgTbl2: @(sdata2,extRegVal) is prefix=0x91 & extRegVal & sdata2 { ptr:3 = extRegVal + sext(sdata2:2); export *:2 ptr; }

# bRWOffset
bArgTbl2: @(sdata2,extRegVal) is prefix=0xA0 & extRegVal & sdata2 { ptr:3 = extRegVal + sext(sdata2:1); export *:1 ptr; }
wArgTbl2: @(sdata2,extRegVal) is prefix=0xA1 & extRegVal & sdata2 { ptr:3 = extRegVal + sext(sdata2:1); export *:2 ptr; }

# bRWAddr
bArgTbl2: @(extRegVal) is prefix=0xB0 & extRegVal { export *:1 extRegVal; }
wArgTbl2: @(extRegVal) is prefix=0xB1 & extRegVal { export *:2 extRegVal; }

# rbDir
bArgTbl2: bConToReg is prefix=0xC0 & bConToReg { export bConToReg; }
wArgTbl2: wConToReg is prefix=0xC1 & wConToReg { export wConToReg; }

# bAddrAbs16
bArgTbl2: val is prefix=0xE0 & data1 [ val = (DP << 16) + data1; ] { tmp:3 = segment(DP,data1:2); export *:1 tmp; }
# bAddrAbs24
bArgTbl2: data1 is prefix=0xE1 & data1 { export *:1 data1; }

bArgTbl2: @(SP+) is prefix=0xE7 & SP { ptr:3 = segment(UTP,SP); SP = SP + 2; export *:1 ptr; }
wArgTbl2: val is prefix=0xE8 & data1 [ val = (DP << 16) + data1; ] { ptr:3 = segment(DP,data1:2); export *:2 ptr; }
wArgTbl2: data1 is prefix=0xE9 & data1 { export *:2 data1; }

wArgTbl2: @(SP+) is prefix=0xEF & SP { ptr:3 = segment(UTP,SP); SP = SP + 2; export *:2 ptr; }

# TODO: Hack, these are from tbl5, begin from 0xF0, no collisions
bArgTbl2: @(-predExtRegVal) is prefix=0xF0 & predExtRegVal { export *:1 predExtRegVal; }
wArgTbl2: @(-predExtRegVal) is prefix=0xF1 & predExtRegVal { export *:2 predExtRegVal; }
bArgTbl2: @(pstiExtRegVal+) is prefix=0xF2 & pstiExtRegVal { export *:1 pstiExtRegVal; }
wArgTbl2: @(pstiExtRegVal+) is prefix=0xF3 & pstiExtRegVal { export *:2 pstiExtRegVal; }

} # end :(phase=1|phase=5|phase=6)

with :(phase=2|phase=5) {

wArgTbl3: data1 is prefix=0xEA & data1 { tmp:2 = data1; export tmp; }
wArgTbl3: data1 is prefix=0xFE & data1 { tmp:2 = zext(data1:1); export tmp; }
bArgTbl3: data1 is prefix=0xD0 & data1 { tmp:1 = data1:1; export tmp; }
wArgTbl3: data1 is prefix=0xD1 & data1 { tmp:2 = zext(data1:1); export tmp; }
bArgTbl3: data1 is prefix=0xE2 & data1 { tmp:1 = data1; export tmp; }

} # end :(phase=2|phase=5)

with :phase=3 {

bArgTbl4: bConToReg is prefix=0x10 & bConToReg { export bConToReg; }
wArgTbl4: wConToReg is prefix=0x10 & wConToReg { export wConToReg; }
lArgTbl4: lConToReg is prefix=0x10 & lConToReg { export lConToReg; }
cArgTbl4: cConToReg is prefix=0x10 & cConToReg { export cConToReg; }

} # end :phase=3

with :(phase=4|phase=5) {

tbl5RelAddr: loc is simm16 [ loc = inst_next + simm16; ] { export *:1 loc; }

} # end :(phase=4|phase=5)

with :(phase=7|phase=5) {

lArgTbl8: #data1 is prefix=0xEA & data1 & tbl8Mode=0 { tmp:4 = zext(data1:2); export tmp; }
lArgTbl8: #data1 is prefix=0xFE & data1 & tbl8Mode=0 { tmp:4 = zext(data1:1); export tmp; }
lArgTbl8: #data1 is prefix=0xD0 & data1 & tbl8Mode=0 { tmp:4 = zext(data1:1); export tmp; }
lArgTbl8: #data1 is prefix=0xD1 & data1 & tbl8Mode=0 { tmp:4 = zext(data1:1); export tmp; }
lArgTbl8: #data1 is prefix=0xE2 & data1 & tbl8Mode=0 { tmp:4 = zext(data1:1); export tmp; }

lArgTbl8: #val is prefix=0xEA & data1 & tbl8Mode=1 & data2 [ val = data1 + (data2 << 16); ] { tmp:4 = zext(data1:2) + (zext(data2:2) << 16); export tmp; }
lArgTbl8: #val is prefix=0xFE & data1 & tbl8Mode=1 & data2 [ val = data1 + (data2 << 16); ] { tmp:4 = zext(data1:1) + (zext(data2:2) << 16); export tmp; }
lArgTbl8: #val is prefix=0xD0 & data1 & tbl8Mode=1 & data2 [ val = data1 + (data2 << 16); ] { tmp:4 = zext(data1:1) + (zext(data2:2) << 16); export tmp; }
lArgTbl8: #val is prefix=0xD1 & data1 & tbl8Mode=1 & data2 [ val = data1 + (data2 << 16); ] { tmp:4 = zext(data1:1) + (zext(data2:2) << 16); export tmp; }
lArgTbl8: #val is prefix=0xE2 & data1 & tbl8Mode=1 & data2 [ val = data1 + (data2 << 16); ] { tmp:4 = zext(data1:1) + (zext(data2:2) << 16); export tmp; }

} # end :(phase=7|phase=5)

with :phase=5 {

wArgTbl62: #val is prefix2=0x0280 [ val = (data3 << 8) + data4; ] { tmp:2 = val; export tmp; }
wArgTbl62: @(sdata4,extRegVal3) is prefix2=0x0290 & sdata4 & extRegVal3 { ptr:3 = extRegVal3 + sext(sdata4:2); export *:2 ptr; }
wArgTbl62: @(sdata4,extRegVal3) is prefix2=0x02A0 & sdata4 & extRegVal3 { ptr:3 = extRegVal3 + sext(sdata4:1); export *:2 ptr; }
wArgTbl62: @(extRegVal3) is prefix2=0x02B0 & extRegVal3 { export *:2 extRegVal3; }
wArgTbl62: wCon3ToReg is prefix2=0x02C0 & wCon3ToReg { export wCon3ToReg; }
wArgTbl62: data3 is prefix2=0x02E0 & data3 { ptr:3 = zext(data3:2); export *:2 ptr; }
wArgTbl62: data3 is prefix2=0x02E1 & data3 { export *:2 data3; }

bArgTbl62: #data4 is prefix2=0x0280 & data4 { tmp:1 = data4:1; export tmp; }
bArgTbl62: @(sdata4,extRegVal3) is prefix2=0x0290 & sdata4 & extRegVal3 { ptr:3 = extRegVal3 + sext(sdata4:2); export *:1 ptr; }
bArgTbl62: @(sdata4,extRegVal3) is prefix2=0x02A0 & sdata4 & extRegVal3 { ptr:3 = extRegVal3 + sext(sdata4:1); export *:1 ptr; }
bArgTbl62: @(extRegVal3) is prefix2=0x02B0 & extRegVal3 { export *:1 extRegVal3; }
bArgTbl62: bCon3ToReg is prefix2=0x02C0 & bCon3ToReg { export bCon3ToReg; }
bArgTbl62: data3 is prefix2=0x02E0 & data3 { ptr:3 = zext(data3:2); export *:1 ptr; }
bArgTbl62: data3 is prefix2=0x02E1 & data3 { export *:1 data3; }

wArgTbl63: #val is prefix2=0x0380 [ val = (data3 << 8) + data4; ] { tmp:2 = val; export tmp; }
wArgTbl63: @(sdata4,extRegVal3) is prefix2=0x0390 & sdata4 & extRegVal3 { ptr:3 = extRegVal3 + sext(sdata4:2); export *:2 ptr; }
wArgTbl63: @(sdata4,extRegVal3) is prefix2=0x03A0 & sdata4 & extRegVal3 { ptr:3 = extRegVal3 + sext(sdata4:1); export *:2 ptr; }
wArgTbl63: @(extRegVal3) is prefix2=0x03B0 & extRegVal3 { export *:2 extRegVal3; }
wArgTbl63: wCon3ToReg is prefix2=0x03C0 & wCon3ToReg { export wCon3ToReg; }
wArgTbl63: data3 is prefix2=0x03E0 & data3 { ptr:3 = zext(data3:2); export *:2 ptr; }
wArgTbl63: data3 is prefix2=0x03E1 & data3 { export *:2 data3; }

bArgTbl63: #data4 is prefix2=0x0380 & data4 { tmp:1 = data4:1; export tmp; }
bArgTbl63: @(sdata4,extRegVal3) is prefix2=0x0390 & sdata4 & extRegVal3 { ptr:3 = extRegVal3 + sext(sdata4:2); export *:1 ptr; }
bArgTbl63: @(sdata4,extRegVal3) is prefix2=0x03A0 & sdata4 & extRegVal3 { ptr:3 = extRegVal3 + sext(sdata4:1); export *:1 ptr; }
bArgTbl63: @(extRegVal3) is prefix2=0x03B0 & extRegVal3 { export *:1 extRegVal3; }
bArgTbl63: bCon3ToReg is prefix2=0x03C0 & bCon3ToReg { export bCon3ToReg; }
bArgTbl63: data3 is prefix2=0x03E0 & data3 { ptr:3 = zext(data3:2); export *:1 ptr; }
bArgTbl63: data3 is prefix2=0x03E1 & data3 { export *:1 data3; }

wArgTbl67: @(-predExtRegVal3) is prefix2=0x0790 & predExtRegVal3 { export *:2 predExtRegVal3; }
wArgTbl67: @(pstiExtRegVal3+) is prefix2=0x07A0 & pstiExtRegVal3 { export *:2 pstiExtRegVal3; }
wArgTbl67: @(pstiExtRegVal3+) is prefix2=0x07A1 & pstiExtRegVal3 { export *:2 pstiExtRegVal3; }

bArgTbl67: @(-predExtRegVal3) is prefix2=0x0790 & predExtRegVal3 { export *:1 predExtRegVal3; }
bArgTbl67: @(pstiExtRegVal3+) is prefix2=0x07A0 & pstiExtRegVal3 { export *:1 pstiExtRegVal3; }
bArgTbl67: @(pstiExtRegVal3+) is prefix2=0x07A1 & pstiExtRegVal3 { export *:1 pstiExtRegVal3; }

lArgTbl68: @(-predExtRegVal3) is prefix2=0x0890 & predExtRegVal3 { export *:4 predExtRegVal3; }
lArgTbl68: @(pstiExtRegVal3+) is prefix2=0x08A0 & pstiExtRegVal3 { export *:4 pstiExtRegVal3; }
lArgTbl68: @(pstiExtRegVal3+) is prefix2=0x08A1 & pstiExtRegVal3 { export *:4 pstiExtRegVal3; }

} # end :phase=5

####### END OP Preludes

cc: "RA" is opMode4_4=0x0 { tmp:1=1; export tmp; }
cc: "RN" is opMode4_4=0x1 { tmp:1=0; export tmp; }
cc: "HI" is opMode4_4=0x2 { tmp:1=!(X||Z); export tmp; }
cc: "LS" is opMode4_4=0x3 { tmp:1=X||Z; export tmp; }
cc: "XC" is opMode4_4=0x4 { tmp:1=!X; export tmp; }
cc: "XS" is opMode4_4=0x5 { tmp:1=X; export tmp; }
cc: "NE" is opMode4_4=0x6 { tmp:1=!Z; export tmp; }
cc: "EQ" is opMode4_4=0x7 { tmp:1=Z; export tmp; }
cc: "VC" is opMode4_4=0x8 { tmp:1=!V; export tmp; }
cc: "VS" is opMode4_4=0x9 { tmp:1=V; export tmp; }
cc: "MC" is opMode4_4=0xA { tmp:1=!M; export tmp; }
cc: "MS" is opMode4_4=0xB { tmp:1=M; export tmp; }
cc: "GE" is opMode4_4=0xC { tmp:1=!(M^^V); export tmp; }
cc: "LT" is opMode4_4=0xD { tmp:1=M^^V; export tmp; }
cc: "GT" is opMode4_4=0xE { tmp:1=!(Z||(M^^V)); export tmp; }
cc: "LE" is opMode4_4=0xF { tmp:1=Z||(M^^V); export tmp; }

stmL7: SP			is SP & stmRW7=1						{ push16(SP - 2); }
stmL7: ""	 		is epsilon								{ }

stmL6: FP			is FP & stmL7 & stmRW6=1 & stmRW7N=0	{ push16(FP); build stmL7; }
stmL6: FP,stmL7		is FP & stmL7 & stmRW6=1				{ push16(FP); build stmL7; }
stmL6: stmL7 		is stmL7								{ build stmL7; }

stmL5: RW5			is RW5 & stmL6 & stmRW5=1 & stmRW6N=0	{ push16(RW5); build stmL6; }
stmL5: RW5,stmL6	is RW5 & stmL6 & stmRW5=1				{ push16(RW5); build stmL6; }
stmL5: stmL6 		is stmL6								{ build stmL6; }

stmL4: RW4			is RW4 & stmL5 & stmRW4=1 & stmRW5N=0	{ push16(RW4); build stmL5; }
stmL4: RW4,stmL5	is RW4 & stmL5 & stmRW4=1				{ push16(RW4); build stmL5; }
stmL4: stmL5 		is stmL5								{ build stmL5; }

stmL3: RW3			is RW3 & stmL4 & stmRW3=1 & stmRW4N=0	{ push16(RW3); build stmL4; }
stmL3: RW3,stmL4	is RW3 & stmL4 & stmRW3=1				{ push16(RW3); build stmL4; }
stmL3: stmL4 		is stmL4								{ build stmL4; }

stmL2: RW2			is RW2 & stmL3 & stmRW2=1 & stmRW3N=0	{ push16(RW2); build stmL3; }
stmL2: RW2,stmL3	is RW2 & stmL3 & stmRW2=1				{ push16(RW2); build stmL3; }
stmL2: stmL3 		is stmL3								{ build stmL3; }

stmL1: RW1			is RW1 & stmL2 & stmRW1=1 & stmRW2N=0	{ push16(RW1); build stmL2; }
stmL1: RW1,stmL2	is RW1 & stmL2 & stmRW1=1				{ push16(RW1); build stmL2; }
stmL1: stmL2 		is stmL2								{ build stmL2; }

stmL0: RW0			is RW0 & stmL1 & stmRW0=1 & stmRW1N=0	{ push16(RW0); build stmL1; }
stmL0: RW0,stmL1	is RW0 & stmL1 & stmRW0=1				{ push16(RW0); build stmL1; }
stmL0: stmL1		is stmL1								{ build stmL1; }

ldmL7: SP			is SP & ldmRW7=1						{ ptr:3 = segment(UTP,SP); SP = *:2 ptr; }
ldmL7: ""	 		is epsilon								{ }

ldmL6: FP			is FP & ldmL7 & ldmRW6=1 & ldmRW7N=0	{ pop16(FP); build ldmL7; }
ldmL6: FP,ldmL7		is FP & ldmL7 & ldmRW6=1				{ pop16(FP); build ldmL7; }
ldmL6: ldmL7 		is ldmL7								{ build ldmL7; }

ldmL5: RW5			is RW5 & ldmL6 & ldmRW5=1 & ldmRW6N=0	{ pop16(RW5); build ldmL6; }
ldmL5: RW5,ldmL6	is RW5 & ldmL6 & ldmRW5=1				{ pop16(RW5); build ldmL6; }
ldmL5: ldmL6 		is ldmL6								{ build ldmL6; }

ldmL4: RW4			is RW4 & ldmL5 & ldmRW4=1 & ldmRW5N=0	{ pop16(RW4); build ldmL5; }
ldmL4: RW4,ldmL5	is RW4 & ldmL5 & ldmRW4=1				{ pop16(RW4); build ldmL5; }
ldmL4: ldmL5 		is ldmL5								{ build ldmL5; }

ldmL3: RW3			is RW3 & ldmL4 & ldmRW3=1 & ldmRW4N=0	{ pop16(RW3); build ldmL4; }
ldmL3: RW3,ldmL4	is RW3 & ldmL4 & ldmRW3=1				{ pop16(RW3); build ldmL4; }
ldmL3: ldmL4 		is ldmL4								{ build ldmL4; }

ldmL2: RW2			is RW2 & ldmL3 & ldmRW2=1 & ldmRW3N=0	{ pop16(RW2); build ldmL3; }
ldmL2: RW2,ldmL3	is RW2 & ldmL3 & ldmRW2=1				{ pop16(RW2); build ldmL3; }
ldmL2: ldmL3 		is ldmL3								{ build ldmL3; }

ldmL1: RW1			is RW1 & ldmL2 & ldmRW1=1 & ldmRW2N=0	{ pop16(RW1); build ldmL2; }
ldmL1: RW1,ldmL2	is RW1 & ldmL2 & ldmRW1=1				{ pop16(RW1); build ldmL2; }
ldmL1: ldmL2 		is ldmL2								{ build ldmL2; }

ldmL0: RW0			is RW0 & ldmL1 & ldmRW0=1 & ldmRW1N=0	{ pop16(RW0); build ldmL1; }
ldmL0: RW0,ldmL1	is RW0 & ldmL1 & ldmRW0=1				{ pop16(RW0); build ldmL1; }
ldmL0: ldmL1		is ldmL1								{ build ldmL1; }

####### TABLE 1

with :phase=0 {

:B^cc relAddr8 is op0_4=0x0 & cc; relAddr8 {
	if (cc) goto relAddr8;
}

:TJSR tjsrAddr3 is op0_4=0x1 & opHalf4_1=0x1 & tjsrAddr3 {
	goto tjsrAddr3;
}

# Maybe use bit accessors instead?
:BSET immAddr8"."bIdx3 is op0_4=0x4 & opHalf4_1=0x0 & bIdx3; immAddr8 {
	local tmp:1 = 1 << bIdx3;
	Z = (immAddr8 & tmp) == 0;
	immAddr8 = immAddr8 | tmp;
}

:BCLR immAddr8"."bIdx3 is op0_4=0x4 & opHalf4_1=0x1 & bIdx3; immAddr8 {
	local tmp:1 = 1 << bIdx3;
	Z = (immAddr8 & tmp) == 0;
	immAddr8 = immAddr8 & (0xFF ^ tmp);
}

:BBC immAddr8"."bIdx3, relAddr8 is op0_4=0x5 & opHalf4_1=0x0 & bIdx3; immAddr8; relAddr8 {
	local tmp:1 = 1 << bIdx3;
	local result:1 = immAddr8 & tmp;
	if (result == 0) goto relAddr8;
}

:BBS immAddr8"."bIdx3, relAddr8 is op0_4=0x5 & opHalf4_1=0x1 & bIdx3; immAddr8; relAddr8 {
	local tmp:1 = 1 << bIdx3;
	local result:1 = immAddr8 & tmp;
	if (result == 1) goto relAddr8;
}

:MOV.IR.B immVal8,bReg5_3 is op0_4=0x6 & opHalf4_1=0x0 & bReg5_3; immVal8 {
	bReg5_3 = immVal8;
}

:MOV.IR.W immVal16,wReg5_3 is op0_4=0x6 & opHalf4_1=0x1 & wReg5_3; immVal16 {
	wReg5_3 = immVal16;
}

:CMP.IR.B immVal8,bReg5_3 is op0_4=0x7 & opHalf4_1=0x0 & bReg5_3; immVal8 {
	subFlags(bReg5_3, immVal8);
	local cmp:1 = bReg5_3 - immVal8;
	zeroFlags(cmp);
}

:CMP.IR.W immVal16,wReg5_3 is op0_4=0x7 & opHalf4_1=0x1 & wReg5_3; immVal16 {
	subFlags(wReg5_3, immVal16);
	local cmp:2 = wReg5_3 - immVal16;
	zeroFlags(cmp);
}

:JSR cpAddr16 is op0_8=0xE4; cpAddr16 {
	#push16(&:2 inst_next);
	call cpAddr16;
}

:JMP cpAddr16 is op0_8=0xE5; cpAddr16 {
	call cpAddr16;
}

:LINK FP,immVal8 is op0_8=0xE6 & FP; immVal8 {
	push16(FP);
	FP = SP;
	SP = SP + zext(immVal8);
}

:PJSR immAddr24 is op0_8=0xEC; immAddr24 {
	#push16(&:2 inst_next);
	#push16(CP);
	#CP = (immAddr24 & 0xFF0000) >> 16;
	call immAddr24;
}

:PJMP immAddr24 is op0_8=0xED; immAddr24 {
	#CP = (immAddr24 & 0xFF0000) >> 16;
	goto immAddr24;
}

:LINK FP,immVal16 is op0_8=0xEE & FP; immVal16 {
	push16(FP);
	FP = SP;
	SP = SP + immVal16;
}

:TRAPE is op0_8=0xF1 {
	# Unimplemented. Trap Exception?
	trapException();
}

:TRAPA immVal8 is op0_8=0xF2; immVal8 {
	push16(&:2 inst_next);
	push16(CP);
	syncFlags();
	push16(PSW);
	
	# TODO:
	# Need to determine where trapA vector table exists
	# then navigate to that vector address
	trap(immVal8);
}

:REIT is op0_8=0xF5 {
	# Is PSW restored from stack?
	#pop16(CP);
	#pop16(PC);
	
	local hi:3 = zext(CP);
	ptr:3 = (hi << 16) + zext(PC);
	
	return [ptr];
}	
	
:UNLK FP is op0_8=0xF6 & FP {
	SP = FP;
	pop16(FP);
}

:LDM ldmL0 is op0_8=0xF7 & ldmL0 {
	build ldmL0;
}

:STM stmL0 is op0_8=0xF8 & stmL0 {
	build stmL0;
}

:RTS is op0_8=0xFA {
	pop16(PC);
	local hi:3 = zext(CP);
	ptr:3 = (hi << 16) + zext(PC);
	
	return [ptr];
}

:PRTS is op0_8=0xFB {
	pop16(CP);
	pop16(PC);
	
	local hi:3 = zext(CP);
	ptr:3 = (hi << 16) + zext(PC);
	
	return [ptr];
}

:EI is op0_8=0xFC {
	enableInterrupts();
}

:DI is op0_8=0xFD {
	disableInterrupts();
}

:NOP is op0_8=0xFF {}

} # end phase=0

####### TABLE 2

with :phase=1 {

:XOR.GR.B bArgTbl2,bReg5_3 is (op0_4=0x0 & opHalf4_1=0 & bReg5_3) ... & bArgTbl2 & tbl2Width=0 {
	bReg5_3 = bReg5_3 ^ bArgTbl2;
	zeroFlags(bReg5_3);
}

:XOR.GR.W wArgTbl2,wReg5_3 is (op0_4=0x0 & opHalf4_1=0 & wReg5_3) ... & wArgTbl2 & tbl2Width=1 {
	wReg5_3 = wReg5_3 ^ wArgTbl2;
	zeroFlags(wReg5_3);
}

:BXOR bArgTbl2"."bIdx3 is (op0_4=0x0 & opHalf4_1=1 & bIdx3) ... & bArgTbl2 & tbl2Width=0 {
	tmp:1 = 1 << bIdx3;
	Z = (bArgTbl2 & tmp) == 0;
	bArgTbl2 = bArgTbl2 ^ tmp;
}

# Not sure why you'd do this?
:BXOR.W wArgTbl2"."bIdx3 is (op0_4=0x0 & opHalf4_1=1 & bIdx3) ... & wArgTbl2 & tbl2Width=1 {
	tmp:2 = 1 << bIdx3;
	Z = (wArgTbl2 & tmp) == 0;
	wArgTbl2 = wArgTbl2 ^ tmp;
}

:OR.GR.B bArgTbl2,bReg5_3 is (op0_4=0x1 & opHalf4_1=0 & bReg5_3) ... & bArgTbl2 & tbl2Width=0 {
	bReg5_3 = bReg5_3 | bArgTbl2;
	zeroFlags(bReg5_3);
}

:OR.GR.W wArgTbl2,wReg5_3 is (op0_4=0x1 & opHalf4_1=0 & wReg5_3) ... & wArgTbl2 & tbl2Width=1 {
	wReg5_3 = wReg5_3 | wArgTbl2;
	zeroFlags(wReg5_3);
}

:BOR bArgTbl2"."bIdx3 is (op0_4=0x1 & opHalf4_1=1 & bIdx3) ... & bArgTbl2 & tbl2Width=0 {
	tmp:1 = 1 << bIdx3;
	Z = (bArgTbl2 & tmp) == 0;
	bArgTbl2 = bArgTbl2 | tmp;
}

# Not sure why you'd do this?
:BOR.W wArgTbl2"."bIdx3 is (op0_4=0x1 & opHalf4_1=1 & bIdx3) ... & wArgTbl2 & tbl2Width=1 {
	tmp:2 = 1 << bIdx3;
	Z = (wArgTbl2 & tmp) == 0;
	wArgTbl2 = wArgTbl2 | tmp;
}

:AND.GR.B bArgTbl2,bReg5_3 is (op0_4=0x2 & opHalf4_1=0 & bReg5_3) ... & bArgTbl2 & tbl2Width=0 {
	bReg5_3 = bReg5_3 | bArgTbl2;
	zeroFlags(bReg5_3);
}

:AND.GR.W wArgTbl2,wReg5_3 is (op0_4=0x2 & opHalf4_1=0 & wReg5_3) ... & wArgTbl2 & tbl2Width=1 {
	wReg5_3 = wReg5_3 | wArgTbl2;
	zeroFlags(wReg5_3);
}

:BAND bArgTbl2"."bIdx3 is (op0_4=0x2 & opHalf4_1=1 & bIdx3) ... & bArgTbl2 & tbl2Width=0 {
	tmp:1 = 1 << bIdx3;
	Z = (bArgTbl2 & tmp) == 0;
	orig:1 = bArgTbl2;
	bArgTbl2 = bArgTbl2 & tmp;
	bArgTbl2 = bArgTbl2 | orig;
}

# Not sure why you'd do this?
:BAND.W wArgTbl2"."bIdx3 is (op0_4=0x2 & opHalf4_1=1 & bIdx3) ... & wArgTbl2 & tbl2Width=1 {
	tmp:2 = 1 << bIdx3;
	Z = (wArgTbl2 & tmp) == 0;
	orig:2 = wArgTbl2;
	wArgTbl2 = wArgTbl2 | tmp;
	wArgTbl2 = wArgTbl2 | orig;
}

:SUBX.GR.B bArgTbl2,bReg5_3 is (op0_4=0x3 & opHalf4_1=0 & bReg5_3) ... & bArgTbl2 & tbl2Width=0 {
	subFlags(bReg5_3,bArgTbl2);
	bReg5_3 = bReg5_3 - bArgTbl2 - X;
	zeroFlags(bReg5_3);
}

:SUBX.GR.W wArgTbl2,wReg5_3 is (op0_4=0x3 & opHalf4_1=0 & wReg5_3) ... & wArgTbl2 & tbl2Width=1 {
	subFlags(wReg5_3,wArgTbl2);
	wReg5_3 = wReg5_3 - wArgTbl2 - zext(X);
	zeroFlags(wReg5_3);
}

:BNOT bArgTbl2"."bIdx3 is (op0_4=0x3 & opHalf4_1=1 & bIdx3) ... & bArgTbl2 & tbl2Width=0 {
	tmp:1 = 1 << bIdx3;
	Z = (bArgTbl2 & tmp) == 0;
	bArgTbl2 = bArgTbl2 ^ tmp;
}

# Not sure why you'd do this?
:BNOT.W wArgTbl2"."bIdx3 is (op0_4=0x3 & opHalf4_1=1 & bIdx3) ... & wArgTbl2 & tbl2Width=1 {
	tmp:2 = 1 << bIdx3;
	Z = (wArgTbl2 & tmp) == 0;
	wArgTbl2 = wArgTbl2 ^ tmp;
}

:ADDX.GR.B bArgTbl2,bReg5_3 is (op0_4=0x4 & opHalf4_1=0 & bReg5_3) ... & bArgTbl2 & tbl2Width=0 {
	addFlags(bReg5_3,bArgTbl2);
	bReg5_3 = bReg5_3 + bArgTbl2 + X;
	zeroFlags(bReg5_3);
}

:ADDX.GR.W wArgTbl2,wReg5_3 is (op0_4=0x4 & opHalf4_1=0 & wReg5_3) ... & wArgTbl2 & tbl2Width=1 {
	addFlags(wReg5_3,wArgTbl2);
	wReg5_3 = wReg5_3 + wArgTbl2 + zext(X);
	zeroFlags(wReg5_3);
}

:BSET bArgTbl2"."bIdx3 is (op0_4=0x4 & opHalf4_1=1 & bIdx3) ... & bArgTbl2 & tbl2Width=0 {
	tmp:1 = 1 << bIdx3;
	Z = (bArgTbl2 & tmp) == 0;
	bArgTbl2 = bArgTbl2 | tmp;
}

# Not sure why you'd do this?
:BSET.W wArgTbl2"."bIdx3 is (op0_4=0x4 & opHalf4_1=1 & bIdx3) ... & wArgTbl2 & tbl2Width=1 {
	tmp:2 = 1 << bIdx3;
	Z = (wArgTbl2 & tmp) == 0;
	wArgTbl2 = wArgTbl2 | tmp;
}

:SUB.GR.B bArgTbl2,bReg5_3 is (op0_4=0x5 & opHalf4_1=0 & bReg5_3) ... & bArgTbl2 & tbl2Width=0 {
	subFlags(bReg5_3,bArgTbl2);
	bReg5_3 = bReg5_3 - bArgTbl2;
	zeroFlags(bReg5_3);
}

:SUB.GR.W wArgTbl2,wReg5_3 is (op0_4=0x5 & opHalf4_1=0 & wReg5_3) ... & wArgTbl2 & tbl2Width=1 {
	subFlags(wReg5_3,wArgTbl2);
	wReg5_3 = wReg5_3 - wArgTbl2;
	zeroFlags(wReg5_3);
}

:BCLR bArgTbl2"."bIdx3 is (op0_4=0x5 & opHalf4_1=1 & bIdx3) ... & bArgTbl2 & tbl2Width=0 {
	tmp:1 = 1 << bIdx3;
	Z = (bArgTbl2 & tmp) == 0;
	tmp = ~tmp;
	bArgTbl2 = bArgTbl2 & tmp;
}

# Not sure why you'd do this?
:BCLR.W wArgTbl2"."bIdx3 is (op0_4=0x5 & opHalf4_1=1 & bIdx3) ... & wArgTbl2 & tbl2Width=1 {
	tmp:2 = 1 << bIdx3;
	Z = (wArgTbl2 & tmp) == 0;
	tmp = ~tmp;
	wArgTbl2 = wArgTbl2 & tmp;
}

:ADD.GR.B bArgTbl2,bReg5_3 is (op0_4=0x6 & opHalf4_1=0 & bReg5_3) ... & bArgTbl2 & tbl2Width=0 {
	addFlags(bReg5_3,bArgTbl2);
	bReg5_3 = bReg5_3 + bArgTbl2;
	zeroFlags(bReg5_3);
}

:ADD.GR.W wArgTbl2,wReg5_3 is (op0_4=0x6 & opHalf4_1=0 & wReg5_3) ... & wArgTbl2 & tbl2Width=1 {
	addFlags(wReg5_3,wArgTbl2);
	wReg5_3 = wReg5_3 + wArgTbl2;
	zeroFlags(wReg5_3);
}

:BLD bArgTbl2"."bIdx3 is (op0_4=0x6 & opHalf4_1=1 & bIdx3) ... & bArgTbl2 & tbl2Width=0 {
	tmp:1 = T << bIdx3;
	Z = (bArgTbl2 & tmp) == 0;
	bArgTbl2 = bArgTbl2 | tmp;
}

# Not sure why you'd do this?
:BLD.W wArgTbl2"."bIdx3 is (op0_4=0x6 & opHalf4_1=1 & bIdx3) ... & wArgTbl2 & tbl2Width=1 {
	tmp:2 = zext(T) << bIdx3;
	Z = (wArgTbl2 & tmp) == 0;
	wArgTbl2 = wArgTbl2 | tmp;
}

:CMP.GR.B bArgTbl2,bReg5_3 is (op0_4=0x7 & opHalf4_1=0 & bReg5_3) ... & bArgTbl2 & tbl2Width=0 {
	subFlags(bReg5_3,bArgTbl2);
	cmp:1 = bReg5_3 - bArgTbl2;
	zeroFlags(cmp);
}

:CMP.GR.W wArgTbl2,wReg5_3 is (op0_4=0x7 & opHalf4_1=0 & wReg5_3) ... & wArgTbl2 & tbl2Width=1 {
	subFlags(wReg5_3,wArgTbl2);
	cmp:2 = wReg5_3 - wArgTbl2;
	zeroFlags(cmp);
}

:BST bArgTbl2"."bIdx3 is (op0_4=0x7 & opHalf4_1=1 & bIdx3) ... & bArgTbl2 & tbl2Width=0 {
	tmp:1 = 1 << bIdx3;
	Z = (bArgTbl2 & tmp) == 0;
	T = bArgTbl2 & tmp;
}

# Not sure why you'd do this?
:BST.W wArgTbl2"."bIdx3 is (op0_4=0x7 & opHalf4_1=1 & bIdx3) ... & wArgTbl2 & tbl2Width=1 {
	tmp:2 = 1 << bIdx3;
	Z = (wArgTbl2 & tmp) == 0;
	T = (wArgTbl2 & tmp) == 1;
}

:MOV.G0.B bArgTbl2,val is (op0_4=0x8 & opHalf4_1=1 & opData5_3; imm8) ... & bArgTbl2 & tbl2Width=0 [ val = (opData5_3 << 8) + imm8; ] {
	val = bArgTbl2;
}

:MOV.G0.W wArgTbl2,val is (op0_4=0x8 & opHalf4_1=1 & opData5_3; imm8) ... & wArgTbl2 & tbl2Width=1 [ val = (opData5_3 << 8) + imm8; ] {
	val = wArgTbl2;
}

:MOV.G0.B bArgTbl2,@(simm16,indRegVal) is (op0_4=0x9 & opHalf4_1=1 & indRegVal; simm16) ... & bArgTbl2 & tbl2Width=0 {
	ptr:3 = indRegVal + sext(simm16:2);
	*:1 ptr = bArgTbl2;
}

:MOV.G0.W wArgTbl2,@(simm16,indRegVal) is (op0_4=0x9 & opHalf4_1=1 & indRegVal; simm16) ... & wArgTbl2 & tbl2Width=1 {
	ptr:3 = indRegVal + sext(simm16:2);
	*:2 ptr = wArgTbl2;
}

:MOV.G0.B bArgTbl2,@(simm8,indRegVal) is (op0_4=0xA & opHalf4_1=1 & indRegVal; simm8) ... & bArgTbl2 & tbl2Width=0 {
	ptr:3 = indRegVal + sext(simm8:1);
	*:1 ptr = bArgTbl2;
}

:MOV.G0.W wArgTbl2,@(simm8,indRegVal) is (op0_4=0xA & opHalf4_1=1 & indRegVal; simm8) ... & wArgTbl2 & tbl2Width=1 {
	ptr:3 = zext(indRegVal) + sext(simm8:1);
	*:2 ptr = wArgTbl2;
}

:MOV.G0.B bArgTbl2,@(indRegVal) is (op0_4=0xB & opHalf4_1=1 & indRegVal) ... & bArgTbl2 & tbl2Width=0 {
	*:1 indRegVal = bArgTbl2;
}

:MOV.G0.W wArgTbl2,@(indRegVal) is (op0_4=0xB & opHalf4_1=1 & indRegVal) ... & wArgTbl2 & tbl2Width=1 {
	*:2 indRegVal = wArgTbl2;
