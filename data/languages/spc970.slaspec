:BBS bArgTbl2"."bIdx3 relAddr8 is (op0_4=0xD & opHalf4_1=1 & bIdx3; relAddr8) ... & bArgTbl2 & tbl2Width=0 {
	tmp:1 = 1 << bIdx3;
	res = (tmp & bArgTbl2) == 1;
	if (res) goto relAddr8;
}

:BBS.W wArgTbl2"."bIdx3 relAddr8 is (op0_4=0xD & opHalf4_1=1 & bIdx3; relAddr8) ... & wArgTbl2 & tbl2Width=1 {
	tmp:2 = 1 << bIdx3;
	res = (tmp & wArgTbl2) == 1;
	if (res) goto relAddr8;
}

:NOT.B bArgTbl2 is (op0_8=0xE4) ... & bArgTbl2 & tbl2Width=0 {
	bArgTbl2 = ~bArgTbl2;
	zeroFlags(bArgTbl2);
}

:NOT.W wArgTbl2 is (op0_8=0xE4) ... & wArgTbl2 & tbl2Width=1 {
	wArgTbl2 = ~wArgTbl2;
	zeroFlags(wArgTbl2);
}

:SWAP.B bArgTbl2 is (op0_8=0xE5) ... & bArgTbl2 & tbl2Width=0 {
