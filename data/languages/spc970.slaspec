:BBC bArgTbl2"."bIdx3 relAddr8 is (op0_4=0xD & opHalf4_1=0 & bIdx3; relAddr8) ... & bArgTbl2 & tbl2Width=0 {
	tmp:1 = 1 << bIdx3;
	res = (tmp & bArgTbl2) == 0;
	if (res) goto relAddr8;
}

:BBC.W wArgTbl2"."bIdx3 relAddr8 is (op0_4=0xD & opHalf4_1=0 & bIdx3; relAddr8) ... & wArgTbl2 & tbl2Width=1 {
	tmp:2 = 1 << bIdx3;
	res = (tmp & wArgTbl2) == 0;
	if (res) goto relAddr8;
