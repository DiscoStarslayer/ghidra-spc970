	bArgTbl2 = (bArgTbl2 >> 4) | tmp;
}

:SWAP.W wArgTbl2 is (op0_8=0xE5) ... & wArgTbl2 & tbl2Width=1 {
	tmp:2 = wArgTbl2 << 8;
	wArgTbl2 = (wArgTbl2 >> 8) | tmp;
}

:NEG.B bArgTbl2 is (op0_8=0xE6) ... & bArgTbl2 & tbl2Width=0 {
