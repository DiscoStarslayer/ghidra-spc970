:ROTL.W wArgTbl2 is (op0_8=0xF4) ... & wArgTbl2 & tbl2Width=1 {
	tmp1:2 = wArgTbl2 >> 15;
	tmp2:2 = wArgTbl2 << 1;
	wArgTbl2 = tmp1 + tmp2;
	zeroFlags(wArgTbl2);
