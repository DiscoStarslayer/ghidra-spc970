}

:SHAL.B bArgTbl2 is (op0_8=0xF0) ... & bArgTbl2 & tbl2Width=0 {
	bArgTbl2 = bArgTbl2 << 1;
	zeroFlags(bArgTbl2);
}

:SHAL.W wArgTbl2 is (op0_8=0xF0) ... & wArgTbl2 & tbl2Width=1 {
	wArgTbl2 = wArgTbl2 << 1;
	zeroFlags(wArgTbl2);
