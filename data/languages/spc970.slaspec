:DEC.W wArgTbl2 is (op0_8=0xED) ... & wArgTbl2 & tbl2Width=1 {
	subFlags(wArgTbl2,1);
	wArgTbl2 = wArgTbl2 - 1;
	zeroFlags(wArgTbl2);
