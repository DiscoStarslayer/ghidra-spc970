:INC.B bArgTbl2 is (op0_8=0xEC) ... & bArgTbl2 & tbl2Width=0 {
	addFlags(bArgTbl2,1);
	bArgTbl2 = bArgTbl2 + 1;
	zeroFlags(bArgTbl2);
}

:INC.W wArgTbl2 is (op0_8=0xEC) ... & wArgTbl2 & tbl2Width=1 {
	addFlags(wArgTbl2,1);
	wArgTbl2 = wArgTbl2 + 1;
	zeroFlags(wArgTbl2);
}

:DEC.B bArgTbl2 is (op0_8=0xED) ... & bArgTbl2 & tbl2Width=0 {
	subFlags(bArgTbl2,1);
	bArgTbl2 = bArgTbl2 - 1;
	zeroFlags(bArgTbl2);
