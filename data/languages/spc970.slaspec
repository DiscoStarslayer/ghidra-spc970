:PUSH.B bArgTbl2 is (op0_8=0xEF) ... & bArgTbl2 & tbl2Width=0 {
	push8(bArgTbl2);
}

:PUSH.W wArgTbl2 is (op0_8=0xEF) ... & wArgTbl2 & tbl2Width=1 {
