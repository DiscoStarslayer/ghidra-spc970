<?xml version="1.0" encoding="UTF-8"?>

<!-- See Relax specification: Ghidra/Framework/SoftwareModeling/data/languages/compiler_spec.rxg -->

<compiler_spec>
  <data_organization>
	<pointer_size value="3" />
  </data_organization>
  <global>
    <range space="ram"/>
    <range space="io"/>
  </global>
  <stackpointer register="xSP" space="ram" growth="negative"/>
  <returnaddress>
    <varnode space="stack" offset="0" size="2"/>
  </returnaddress>
  <default_proto>
    <prototype name="__asm" extrapop="4" stackshift="4">
      <input>
        <pentry minsize="1" maxsize="500" align="2">
          <addr offset="4" space="stack"/>
        </pentry>
      </input>
      <output>
      	<pentry minsize="1" maxsize="1">
      	  <register name="RB0"/>
      	</pentry>
        <pentry minsize="2" maxsize="2">
          <register name="RW0"/>
        </pentry>
        <pentry minsize="4" maxsize="4">
          <register name="RL0"/>
        </pentry>
      </output>
      <unaffected>
        <register name="xSP"/>
        <register name="xFP"/>
        <register name="EP"/>
        <register name="RW2"/>
        <register name="RW3"/>
      </unaffected>
      <likelytrash>
      	<register name="CP"/>
      </likelytrash>
    </prototype>
  </default_proto>
  <prototype name="__sys" extrapop="4" stackshift="4" strategy="register">
      <input>
        <pentry minsize="1" maxsize="500" align="2">
          <addr offset="4" space="stack"/>
        </pentry>
      </input>
      <output>
    	<pentry minsize="1" maxsize="1">
      	  <register name="RB0"/>
      	</pentry>
        <pentry minsize="2" maxsize="2">
          <register name="RW0"/>
        </pentry>
        <pentry minsize="4" maxsize="4">
          <register name="RL0"/>
        </pentry>
      </output>
      <unaffected>
        <register name="xSP"/>
        <register name="xFP"/>
        <register name="RW2"/>
        <register name="RW3"/>
        <register name="RW4"/>
        <register name="RW5"/>
        <register name="EP"/>
        <register name="DP"/>
      </unaffected>
      <likelytrash>
      	<register name="CP"/>
      </likelytrash>
  </prototype>
</compiler_spec>
